{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ElleryHe/FeedCourier-Plugins/main/schema/bridge-protocol.schema.json",
  "title": "FeedCourier HTTP Bridge Plugin Protocol v1",
  "description": "Wire request and response schemas for out-of-process HTTP Bridge Plugins (processor, channel, and on_delivered hooks). All requests are signed with HMAC-SHA256 over \"{X-FeedCourier-Timestamp}.{raw_body}\" (replay window ±300s).",
  "$defs": {
    "SignatureHeaders": {
      "type": "object",
      "description": "HTTP headers attached by FeedCourier core to every bridge request.",
      "required": [
        "X-FeedCourier-Timestamp",
        "X-FeedCourier-Signature",
        "X-FeedCourier-Plugin-Id"
      ],
      "properties": {
        "X-FeedCourier-Timestamp": {
          "type": "string",
          "pattern": "^[0-9]{9,12}$",
          "description": "Unix epoch seconds when the request was signed. Receivers MUST reject timestamps outside ±300 seconds."
        },
        "X-FeedCourier-Signature": {
          "type": "string",
          "pattern": "^v1=[0-9a-f]{64}$",
          "description": "HMAC-SHA256 hex digest computed as v1=hex(HMAC_SHA256(BRIDGE_SECRET, \"{timestamp}.{raw_body}\"))."
        },
        "X-FeedCourier-Plugin-Id": {
          "type": "string",
          "description": "Registered plugin ID (or \"pending\" during initial registration GET /manifest)."
        },
        "X-FeedCourier-Idempotency-Key": {
          "type": "string",
          "description": "Deterministic SHA-256 idempotency key included on /deliver, /hooks/on_render, and /hooks/on_delivered."
        }
      }
    },
    "ManifestResponse": {
      "type": "object",
      "description": "Response returned by GET /manifest.",
      "required": ["id", "name", "version", "api_version", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "api_version": { "type": "string", "const": "1" },
        "kind": { "type": "string", "enum": ["processor", "channel"] },
        "runtime": { "type": "string", "const": "bridge" },
        "min_core": { "type": "string" },
        "category": { "type": "string" },
        "icon": { "type": "string" },
        "description": { "type": "string" },
        "homepage": { "type": "string" },
        "hooks": {
          "type": "array",
          "items": { "type": "string", "enum": ["on_render", "on_ingest", "on_delivered"] }
        },
        "permissions": {
          "type": "array",
          "items": { "type": "string", "enum": ["network"] }
        },
        "instance_schema": { "type": "object" },
        "route_option_schema": { "type": "object" },
        "account_schema": { "type": "object" },
        "destination_schema": { "type": "object" },
        "capabilities": { "type": "object" }
      }
    },
    "ValidateRequest": {
      "type": "object",
      "description": "Request sent to POST /validate.",
      "required": ["scope", "config"],
      "properties": {
        "scope": { "type": "string", "enum": ["account", "destination", "instance"] },
        "config": { "type": "object" }
      }
    },
    "ValidateResponse": {
      "type": "object",
      "description": "Response returned by POST /validate.",
      "required": ["ok"],
      "properties": {
        "ok": { "type": "boolean" },
        "error": { "type": "string" },
        "normalized_config": { "type": "object" }
      }
    },
    "TestRequest": {
      "type": "object",
      "description": "Request sent to POST /test.",
      "required": ["scope"],
      "properties": {
        "scope": { "type": "string", "enum": ["account", "destination", "instance"] },
        "account": { "type": "object" },
        "destination": { "type": "object" },
        "config": { "type": "object" }
      }
    },
    "TestResponse": {
      "type": "object",
      "description": "Response returned by POST /test.",
      "required": ["ok"],
      "properties": {
        "ok": { "type": "boolean" },
        "message": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "MediaAttachment": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "url": { "type": "string" },
        "mime_type": { "type": ["string", "null"] },
        "caption": { "type": ["string", "null"] }
      }
    },
    "DeliverRequest": {
      "type": "object",
      "description": "Request sent to POST /deliver (30s timeout; entry content_html/url already include on_render overrides).",
      "required": ["idempotency_key", "task_id", "attempt", "account", "destination", "entry", "feed", "route"],
      "properties": {
        "idempotency_key": { "type": "string" },
        "task_id": { "type": "integer" },
        "attempt": { "type": "integer", "minimum": 1 },
        "account": { "type": "object" },
        "destination": { "type": "object" },
        "entry": {
          "type": "object",
          "properties": {
            "title": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"] },
            "summary_text": { "type": ["string", "null"] },
            "content_html": { "type": ["string", "null"] },
            "plain_text": { "type": "string" },
            "author": { "type": ["string", "null"] },
            "published_at": { "type": ["integer", "null"] },
            "media": { "type": "array", "items": { "$ref": "#/$defs/MediaAttachment" } }
          }
        },
        "feed": {
          "type": "object",
          "properties": {
            "id": { "type": "integer" },
            "title": { "type": "string" },
            "url": { "type": "string" }
          }
        },
        "route": {
          "type": "object",
          "properties": {
            "id": { "type": "integer" },
            "name": { "type": "string" },
            "locale": { "type": ["string", "null"] },
            "timezone": { "type": "string" }
          }
        },
        "checkpoint": { "description": "Previously saved checkpoint JSON state (≤ 16 KiB) or null." }
      }
    },
    "DeliverResponse": {
      "type": "object",
      "description": "Response returned by POST /deliver. HTTP 429 -> retry (honors Retry-After); HTTP 5xx -> retry; other 4xx -> permanent_failure.",
      "required": ["outcome"],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["delivered", "retry", "permanent_failure", "deferred"]
        },
        "retry_after_secs": { "type": "integer", "minimum": 1 },
        "next_window_at": { "type": "integer" },
        "checkpoint": { "description": "Opaque JSON checkpoint persisted across retries (max 16 KiB serialized)." },
        "diagnostic": { "type": "string" },
        "external_id": { "type": "string" }
      }
    },
    "OnRenderRequest": {
      "type": "object",
      "description": "Request sent to POST /hooks/on_render (10s timeout).",
      "required": ["idempotency_key", "plugin_id", "entry", "feed", "route"],
      "properties": {
        "idempotency_key": { "type": "string" },
        "plugin_id": { "type": "string" },
        "instance_config": {},
        "route_option": { "type": "object" },
        "entry": {
          "type": "object",
          "properties": {
            "title": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"] },
            "summary_text": { "type": ["string", "null"] },
            "content_html": { "type": ["string", "null"] },
            "author": { "type": ["string", "null"] },
            "published_at": { "type": ["integer", "null"] }
          }
        },
        "feed": { "type": "object" },
        "route": { "type": "object" },
        "write_cache": { "type": "boolean" }
      }
    },
    "OnRenderResponse": {
      "type": "object",
      "description": "Response returned by POST /hooks/on_render. Returned content_html is always re-sanitized through ammonia by FeedCourier core.",
      "properties": {
        "outcome": { "type": "string", "enum": ["continue", "retry"] },
        "content_html": { "type": "string" },
        "primary_link": { "type": "string", "format": "uri" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "diagnostic": { "type": "string" },
        "retry_after_secs": { "type": "integer", "minimum": 1 }
      }
    },
    "OnDeliveredRequest": {
      "type": "object",
      "description": "Persistent at-least-once event sent to POST /hooks/on_delivered (retried up to 5 times with exponential backoff).",
      "required": ["event", "idempotency_key", "payload"],
      "properties": {
        "event": { "type": "string", "const": "on_delivered" },
        "idempotency_key": { "type": "string" },
        "payload": {
          "type": "object",
          "properties": {
            "task_id": { "type": "integer" },
            "entry": { "type": "object" },
            "feed": { "type": "object" },
            "route": { "type": "object" },
            "channel": { "type": "object" },
            "destination": { "type": "object" },
            "status_code": { "type": ["integer", "null"] },
            "delivered_at": { "type": "integer" }
          }
        }
      }
    },
    "OnDeliveredResponse": {
      "type": "object",
      "description": "Any 2xx response acknowledges the event; non-2xx triggers exponential retry up to 5 attempts.",
      "properties": {
        "ok": { "type": "boolean" }
      }
    }
  }
}
